  "dependencies": {
    "@holydeck/contracts": "workspace:*",
    "@holydeck/localization": "workspace:*",
    "@holydeck/renderer": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "browserslist": "^4.28.9",
    "esbuild": "^0.28.2",
    "vitest": "^5.0.0"
  }
