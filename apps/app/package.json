{
  "name": "@holydeck/app",
  "version": "2026.9.2",
  "description": "HolyDeck application backend: validated settings, same-origin web delivery, and the corpus client",
  "license": "MIT",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./boot": {
      "types": "./dist/boot.d.ts",
      "import": "./dist/boot.js"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "import": "./dist/settings.js"
    },
    "./queue": {
      "types": "./dist/queue.d.ts",
      "import": "./dist/queue.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js"
    },
    "./repositories": {
      "types": "./dist/repositories.d.ts",
      "import": "./dist/repositories.js"
    },
    "./backups": {
      "types": "./dist/backups.d.ts",
      "import": "./dist/backups.js"
    },
    "./backup-retention": {
      "types": "./dist/backup-retention.d.ts",
      "import": "./dist/backup-retention.js"
    },
    "./restores": {
      "types": "./dist/restores.d.ts",
      "import": "./dist/restores.js"
    },
    "./restore-apply": {
      "types": "./dist/restore-apply.d.ts",
      "import": "./dist/restore-apply.js"
    },
    "./sessions": {
      "types": "./dist/sessions.d.ts",
      "import": "./dist/sessions.js"
    },
    "./migrations": {
      "types": "./dist/migrations.d.ts",
      "import": "./dist/migrations.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "lint": "eslint src test",
    "migrate": "node dist/migrate.js",
    "deploy-preflight": "node dist/deploy-preflight-cli.js",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "@holydeck/contracts": "workspace:*",
    "@holydeck/core": "workspace:*",
    "@holydeck/localization": "workspace:*",
    "@holydeck/renderer": "workspace:*",
    "@simplewebauthn/server": "^14.0.1",
    "fastify": "^5.12.3",
    "mongodb": "^6.21.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "fflate": "^0.8.3",
    "mongodb-memory-server": "^10.4.3",
    "tsup": "^8.5.1",
    "vitest": "^5.0.0"
  }
}
