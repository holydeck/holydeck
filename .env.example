# Copy to .env (or export these in your shell) before `docker compose up`.

# Published image tag to deploy. Pin a specific calver version (e.g. 2026.9.0) so a later
# `docker compose pull` or container restart cannot silently change what is running — see
# "Upgrading a deployment" in MAINTENANCE.md for the deliberate, preflighted way to move to a
# new one. "latest" and "next" are moving pointers at the newest stable and prerelease build;
# use one only if always running the newest build, sight unseen, is what this deployment wants.
HOLYDECK_VERSION=2026.9.0

# Long, random shared secret between the app and the corpus. Generate one with:
#   openssl rand -hex 32
# Do not reuse the example values already used in compose.dev.yaml/compose.test.yaml.
HOLYDECK_CORPUS_TOKEN=changeme
