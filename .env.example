# Copy to .env (or export these in your shell) before `docker compose up`.

# Published image tag to deploy. Use "latest" for the newest stable release, or a
# specific tag such as "next" or a calver version (e.g. 2026.9.0).
HOLYDECK_VERSION=latest

# Long, random shared secret between the app and the corpus. Generate one with:
#   openssl rand -hex 32
# Do not reuse the example values already used in compose.dev.yaml/compose.test.yaml.
HOLYDECK_CORPUS_TOKEN=changeme
